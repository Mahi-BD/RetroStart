<Window x:Class="WinlyStart.UI.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="TodayText" FontSize="18" FontWeight="SemiBold" Margin="4,0,0,10"/>
        <Calendar x:Name="Cal" DisplayDateChanged="Cal_Changed" SelectedDatesChanged="Cal_Changed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Today" Width="90" Height="28" Margin="0,0,8,0" Click="Today_Click"/>
            <Button Content="Close" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
