<Window x:Class="WinlyStart.UI.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar" Width="1120" Height="660" MinWidth="820" MinHeight="380"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Dlg.Bg}" Foreground="{DynamicResource Dlg.Text}"
        SizeChanged="Window_SizeChanged" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource DlgIconButton}"/>
        <Style TargetType="Button" BasedOn="{StaticResource DlgButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource DlgTextBox}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DlgComboBox}"/>

        <!-- day cell: flat, and stretches to fill its share of the month grid -->
        <Style x:Key="DayButton" TargetType="Button">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource Dlg.Card}"/>
            <Setter Property="Foreground" Value="{DynamicResource Dlg.Text}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="Hover" Background="{DynamicResource Dlg.Hover}" Opacity="0.5"
                                        CornerRadius="3" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource NavButton}" Content="&#xE76B;" Click="Prev_Click" ToolTip="Previous month"/>
                <Button Style="{StaticResource NavButton}" Content="&#xE76C;" Margin="4,0,10,0" Click="Next_Click" ToolTip="Next month"/>
                <Button Content="Today" MinWidth="80" Click="Today_Click"/>
            </StackPanel>
            <TextBlock x:Name="HeaderText" Style="{StaticResource DlgH1}" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="CountText" Style="{StaticResource DlgCaption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- three months (fill the space) + note panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="MonthsHost">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
            </Grid>

            <Border Grid.Column="1" Margin="14,0,0,0" Style="{StaticResource DlgCard}" Padding="14">
                <DockPanel>
                    <TextBlock x:Name="NoteTitle" DockPanel.Dock="Top" Style="{StaticResource DlgH2}"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Categories…" MinWidth="0" Height="32" Padding="10,0"
                                Margin="8,0,0,0" Click="Categories_Click" ToolTip="Add, edit or delete categories"/>
                        <ComboBox x:Name="CategoryBox" SelectionChanged="CategoryBox_Changed"
                                  ToolTip="Colour category for this day">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0" Background="{Binding Brush}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Content="Delete note" MinWidth="0" Height="30" Padding="12,0" Click="DeleteNote_Click"/>
                        <TextBlock x:Name="SavedText" Style="{StaticResource DlgCaption}" VerticalAlignment="Center" Text="Saved automatically"/>
                    </DockPanel>
                    <TextBox x:Name="NoteBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" TextChanged="NoteBox_TextChanged"
                             ToolTip="Write a note for the selected day. Days with a note take their category colour."/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- footer: category legend + actions -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Import…" Margin="0,0,10,0" Click="Import_Click"
                        ToolTip="Import notes from a .json or .ics (iCalendar) file"/>
                <Button Content="Export…" Margin="0,0,10,0" Click="Export_Click"
                        ToolTip="Export all notes to .json or .ics (iCalendar)"/>
                <Button Content="Close" Style="{StaticResource DlgPrimaryButton}" Click="Close_Click"/>
            </StackPanel>
            <ItemsControl x:Name="Legend" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Border Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0" Background="{Binding Brush}"/>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DlgCaption}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Grid>
</Window>
