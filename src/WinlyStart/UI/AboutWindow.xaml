<Window x:Class="WinlyStart.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Winly Start" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="24,20">
        <TextBlock Text="Winly Start" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Opacity="0.7" Margin="0,2,0,14"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="The Windows 10 Start menu, back on Windows 11. Open source under the MIT licence."/>
        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                   Text="Winly Start never modifies Windows. Quit it from the tray icon and the Windows 11 Start menu is back instantly."/>
        <TextBlock Margin="0,0,0,4">
            <Hyperlink NavigateUri="https://github.com/Mahi-BD/WinlyStart" RequestNavigate="Link_Click">
                github.com/Mahi-BD/WinlyStart
            </Hyperlink>
        </TextBlock>
        <TextBlock x:Name="DataPathText" Opacity="0.6" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Button Content="Close" Width="90" Height="30" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True"/>
    </StackPanel>
</Window>
