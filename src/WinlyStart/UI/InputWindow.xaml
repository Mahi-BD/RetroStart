<Window x:Class="WinlyStart.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add website" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource Dlg.Bg}" Foreground="{DynamicResource Dlg.Text}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource DlgButton}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource DlgTextBox}"/>
        <Style TargetType="TextBlock" BasedOn="{StaticResource DlgBody}"/>
    </Window.Resources>
    <StackPanel Margin="28,24,28,22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource Dlg.Accent}" Margin="0,0,14,0">
                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Dlg.AccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Prompt" Text="Add a website to Start" Style="{StaticResource DlgH1}" FontSize="20"/>
                <TextBlock Text="It appears as a tile and opens in your default browser." Style="{StaticResource DlgCaption}"/>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource DlgCard}">
            <StackPanel>
                <TextBlock Text="Address" Style="{StaticResource DlgCaption}" Margin="0,0,0,4"/>
                <TextBox x:Name="ValueBox" Text="https://"/>
                <TextBlock Text="Name" Style="{StaticResource DlgCaption}" Margin="0,12,0,4"/>
                <TextBox x:Name="NameBox"/>
                <TextBlock x:Name="ErrorText" Foreground="#D13438" Margin="0,8,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="Add" Style="{StaticResource DlgPrimaryButton}" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
