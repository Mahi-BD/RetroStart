<Window x:Class="WinlyStart.UI.InputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add website" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="Prompt" Text="Add a website to Start" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <TextBlock Text="Address" Margin="0,0,0,4"/>
        <TextBox x:Name="ValueBox" Height="28" VerticalContentAlignment="Center" Text="https://"/>
        <TextBlock Text="Name" Margin="0,12,0,4"/>
        <TextBox x:Name="NameBox" Height="28" VerticalContentAlignment="Center"/>
        <TextBlock x:Name="ErrorText" Foreground="#D13438" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Add" Width="90" Height="30" IsDefault="True" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" Height="30" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
