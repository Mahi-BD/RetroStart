<Window x:Class="WinlyStart.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winly Start settings" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="24,20">
        <TextBlock Text="Winly Start" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="The Windows 10 Start menu, back on Windows 11." Opacity="0.7" Margin="0,2,0,18"/>

        <TextBlock Text="Replace the Windows 11 Start menu" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <CheckBox x:Name="WinKey" Content="Windows key and Ctrl+Esc open Winly Start" Margin="0,3"/>
        <CheckBox x:Name="StartButton" Content="Clicking the Start button opens Winly Start" Margin="0,3"/>
        <CheckBox x:Name="Autostart" Content="Start with Windows (current user only)" Margin="0,3"/>

        <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,16,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox x:Name="ThemeBox" Grid.Column="1" Margin="0,4" Width="200" HorizontalAlignment="Left">
                <ComboBoxItem Content="Follow Windows"/>
                <ComboBoxItem Content="Light"/>
                <ComboBoxItem Content="Dark"/>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Tile columns" VerticalAlignment="Center" Margin="0,4"/>
            <ComboBox x:Name="ColumnsBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Width="200" HorizontalAlignment="Left">
                <ComboBoxItem Content="3 medium tiles (6 units)"/>
                <ComboBoxItem Content="4 medium tiles (8 units)"/>
            </ComboBox>
            <TextBlock Grid.Row="2" Text="Menu height" VerticalAlignment="Center" Margin="0,4"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <Slider x:Name="HeightSlider" Width="160" Minimum="480" Maximum="1000" TickFrequency="20" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ElementName=HeightSlider, Path=Value, StringFormat={}{0:0} px}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <CheckBox x:Name="AtStartButton" Content="Open under the Start button instead of the screen corner" Margin="0,8,0,3"/>
        <CheckBox x:Name="Recent" Content="Show “Recently added”" Margin="0,3"/>
        <CheckBox x:Name="MostUsed" Content="Show “Most used”" Margin="0,3"/>
        <CheckBox x:Name="Trim" Content="Trim memory when the menu is hidden" Margin="0,3"/>

        <TextBlock Margin="0,16,0,0" Opacity="0.7" TextWrapping="Wrap"
                   Text="Winly Start never modifies Windows. Quit it from the tray icon and the Windows 11 Start menu is back instantly."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="OK" Width="90" Height="30" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"/>
            <Button Content="Cancel" Width="90" Height="30" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
